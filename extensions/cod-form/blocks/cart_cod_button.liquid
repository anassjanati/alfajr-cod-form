{% assign alfajr_cod_settings = app.metafields.cod_settings.theme.value %}

{% assign button_text = alfajr_cod_settings.buttonText | default: "Commander en paiement à la livraison" %}
{% assign button_icon = alfajr_cod_settings.buttonIcon | default: "🚚" %}
{% assign button_color = alfajr_cod_settings.buttonColor | default: "#0D47C7" %}
{% assign button_text_color = alfajr_cod_settings.buttonTextColor | default: "#FFFFFF" %}
{% assign button_width = alfajr_cod_settings.buttonWidth | default: "100%" %}
{% assign border_radius = alfajr_cod_settings.borderRadius | default: 14 %}

<div
  class="alfajr-cart-cod-trigger"
  data-alfajr-cart-cod-trigger
  data-alfajr-cod-source="cart-drawer"
>
  <button
    type="button"
    class="alfajr-cart-cod-btn"
    data-alfajr-cart-cod-open
    aria-haspopup="dialog"
  >
    <span aria-hidden="true">{{ button_icon }}</span>
    <span data-alfajr-cart-cod-label>{{ button_text }}</span>
  </button>

  <p
    class="alfajr-cart-cod-status"
    data-alfajr-cart-cod-status
    role="status"
    aria-live="polite"
    hidden
  ></p>
</div>

<style>
  .alfajr-cart-cod-trigger {
    margin-top: 10px;
  }

  .alfajr-cart-cod-btn {
    width: {{ button_width }};
    min-height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 16px 18px;
    border: 0;
    border-radius: {{ border_radius }}px;
    background: {{ button_color }};
    color: {{ button_text_color }};
    font: inherit;
    font-size: 16px;
    font-weight: 900;
    cursor: pointer;
    box-shadow: 0 14px 32px rgba(13, 71, 199, .22);
    transition: transform .18s ease, box-shadow .18s ease, opacity .18s ease;
  }

  .alfajr-cart-cod-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 18px 42px rgba(13, 71, 199, .28);
  }

  .alfajr-cart-cod-btn:disabled {
    opacity: .7;
    cursor: wait;
  }

  .alfajr-cart-cod-status {
    margin: 8px 0 0;
    color: #b91c1c;
    font-size: 13px;
    font-weight: 700;
  }
</style>

<script>
  (() => {
    'use strict';

    if (window.__ALFAJR_CART_COD_TRIGGER_V2__) return;
    window.__ALFAJR_CART_COD_TRIGGER_V2__ = true;

    const toCents = (value) => {
      const amount = Number(value);
      return Number.isFinite(amount) ? Math.max(0, Math.round(amount)) : 0;
    };

    const toQuantity = (value) => {
      const quantity = Math.floor(Number(value));
      return Number.isFinite(quantity)
        ? Math.min(100, Math.max(1, quantity))
        : 1;
    };

    function getCartUrl() {
      const root = String(window.Shopify?.routes?.root || '/');
      return `${root.endsWith('/') ? root : `${root}/`}cart.js`;
    }

    function normalizeCartItem(item) {
      const variantId = String(item?.variant_id || item?.id || '').trim();

      if (!variantId) return null;

      const quantity = toQuantity(item.quantity);
      const unitPriceCents = toCents(item.final_price ?? item.price ?? 0);
      const finalLinePrice = Number(item.final_line_price);

      return {
        variantId,
        quantity,
        title: String(item.product_title || item.title || 'Produit'),
        variantTitle:
          item.variant_title && item.variant_title !== 'Default Title'
            ? String(item.variant_title)
            : '',
        image:
          typeof item.image === 'string'
            ? item.image
            : typeof item.featured_image?.url === 'string'
              ? item.featured_image.url
              : '',
        unitPriceCents,
        linePriceCents: Number.isFinite(finalLinePrice)
          ? toCents(finalLinePrice)
          : unitPriceCents * quantity
      };
    }

    function createCartContext(cart, source) {
      const items = Array.isArray(cart?.items)
        ? cart.items.map(normalizeCartItem).filter(Boolean)
        : [];

      if (!items.length) {
        throw new Error('Votre panier est vide. Ajoutez un produit avant de commander.');
      }

      return {
        mode: 'cart',
        source,
        cartToken: String(cart.token || ''),
        currency: String(cart.currency || 'MAD'),
        itemCount: Number(cart.item_count || items.length),
        subtotalCents: toCents(cart.total_price),
        items
      };
    }

    async function fetchFreshCart() {
      const response = await fetch(getCartUrl(), {
        method: 'GET',
        headers: { Accept: 'application/json' },
        credentials: 'same-origin',
        cache: 'no-store'
      });

      if (!response.ok) {
        throw new Error('Impossible de charger votre panier. Réessayez.');
      }

      return response.json();
    }

    function getUi(button) {
      const wrapper = button.closest('[data-alfajr-cart-cod-trigger]');

      return {
        label: button.querySelector('[data-alfajr-cart-cod-label]'),
        status: wrapper?.querySelector('[data-alfajr-cart-cod-status]')
      };
    }

    function setLoading(button, loading) {
      const { label } = getUi(button);

      button.disabled = loading;
      button.setAttribute('aria-busy', String(loading));

      if (!label) return;

      if (!label.dataset.defaultLabel) {
        label.dataset.defaultLabel = label.textContent.trim();
      }

      label.textContent = loading
        ? 'Préparation de la commande...'
        : label.dataset.defaultLabel;
    }

    function setStatus(button, message = '') {
      const { status } = getUi(button);

      if (!status) return;

      status.textContent = message;
      status.hidden = !message;
    }

    document.addEventListener('click', async (event) => {
      const button = event.target.closest('[data-alfajr-cart-cod-open]');

      if (!button || button.disabled) return;

      event.preventDefault();

      try {
        setStatus(button);
        setLoading(button, true);

        const cart = await fetchFreshCart();

        const context = createCartContext(
          cart,
          button.closest('[data-alfajr-cart-cod-trigger]')
            ?.dataset.alfajrCodSource || 'cart-drawer'
        );

        if (typeof window.ALFajrCOD?.open !== 'function') {
          throw new Error(
            'Le formulaire de commande est indisponible sur cette page.'
          );
        }

        window.ALFajrCOD.open(context, { trigger: button });
      } catch (error) {
        setStatus(
          button,
          error?.message || 'Erreur de connexion. Veuillez réessayer.'
        );
      } finally {
        setLoading(button, false);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "AL FAJR Cart COD Button",
  "target": "section",
  "settings": []
}
{% endschema %}