{% assign alfajr_cod_settings = app.metafields.cod_settings.theme.value %}

{% assign alfajr_button_text = alfajr_cod_settings.buttonText | default: block.settings.button_text %}
{% assign alfajr_button_icon = alfajr_cod_settings.buttonIcon | default: "🚚" %}
{% assign alfajr_button_color = alfajr_cod_settings.buttonColor | default: block.settings.button_color %}
{% assign alfajr_button_text_color = alfajr_cod_settings.buttonTextColor | default: block.settings.button_text_color %}
{% assign alfajr_button_width = alfajr_cod_settings.buttonWidth | default: "100%" %}
{% assign alfajr_border_radius = alfajr_cod_settings.borderRadius | default: 14 %}
{% assign alfajr_form_bg = alfajr_cod_settings.formBackgroundColor | default: block.settings.background_color %}
{% assign alfajr_form_text = alfajr_cod_settings.formTextColor | default: "#111827" %}
{% assign alfajr_form_border = alfajr_cod_settings.formBorderColor | default: "#E5E7EB" %}
{% assign alfajr_form_accent = alfajr_cod_settings.formAccentColor | default: alfajr_button_color %}
{% assign alfajr_popup_title = alfajr_cod_settings.popupTitle | default: block.settings.title %}
{% assign alfajr_custom_css = alfajr_cod_settings.customCss | default: "" %}

<div
  class="alfajr-cod-v2"
  data-alfajr-cod-root="{{ block.id }}"
  data-default-variant="{{ product.selected_or_first_available_variant.id }}"
>
  <button type="button" class="alfajr-cod-v2__open" data-cod-open>
    <span aria-hidden="true">{{ alfajr_button_icon }}</span>
    <span>{{ alfajr_button_text }}</span>
  </button>

  <div class="alfajr-cod-v2__overlay" data-cod-overlay aria-hidden="true">
    <section
      class="alfajr-cod-v2__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="alfajr-cod-title-{{ block.id }}"
    >
      <button
        type="button"
        class="alfajr-cod-v2__close"
        data-cod-close
        aria-label="Fermer"
      >×</button>

      <div data-cod-form-panel>
        <header class="alfajr-cod-v2__header">
          <span class="alfajr-cod-v2__eyebrow">Paiement à la livraison</span>
          <h2 id="alfajr-cod-title-{{ block.id }}">{{ alfajr_popup_title }}</h2>
          <p>Remplissez les informations ci-dessous. La commande sera confirmée par téléphone.</p>
        </header>

        <div class="alfajr-cod-v2__product" data-cod-product-card>
  <img
    src="{{ product.selected_or_first_available_variant.featured_image | default: product.featured_image | image_url: width: 180 }}"
    alt="{{ product.title | escape }}"
    width="76"
    height="76"
    loading="eager"
    data-cod-product-image
  >

  <div class="alfajr-cod-v2__product-copy">
    <strong>{{ product.title }}</strong>

    <span
      class="alfajr-cod-v2__variant"
      data-cod-variant-row
      {% if product.has_only_default_variant %}hidden{% endif %}
    >
      Variante :
      <b data-cod-variant-title>
        {{ product.selected_or_first_available_variant.title }}
      </b>
    </span>

    <span class="alfajr-cod-v2__product-meta">
      <b data-cod-unit-price>
        {{ product.selected_or_first_available_variant.price | money_without_currency }} DH
      </b>

      <i aria-hidden="true">•</i>

      Livraison Fès 20 DH, autres villes 35 DH
    </span>
  </div>
</div>

<div
  class="alfajr-cod-v2__cart-products"
  data-cod-cart-products
  aria-live="polite"
  hidden
></div>

        <form class="alfajr-cod-v2__form" data-cod-form novalidate>
          <input type="hidden" name="variant_id" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="form_started_at" value="">
          <input type="hidden" name="idempotency_key" value="">

          <div class="alfajr-cod-v2__honeypot" aria-hidden="true">
            <label>Website</label>
            <input type="text" name="website" tabindex="-1" autocomplete="off">
          </div>

          {% if alfajr_cod_settings.showQuantity == nil or alfajr_cod_settings.showQuantity %}
            <div class="alfajr-cod-v2__field alfajr-cod-v2__field--quantity">
              <label for="alfajr-qty-{{ block.id }}">Quantité</label>
              <div class="alfajr-cod-v2__quantity">
                <button type="button" data-qty-minus aria-label="Réduire la quantité">−</button>
                <input
                  id="alfajr-qty-{{ block.id }}"
                  type="number"
                  name="quantity"
                  value="1"
                  min="1"
                  max="100"
                  inputmode="numeric"
                  required
                >
                <button type="button" data-qty-plus aria-label="Augmenter la quantité">+</button>
              </div>
            </div>
          {% else %}
            <input type="hidden" name="quantity" value="1">
          {% endif %}

          <div class="alfajr-cod-v2__grid">
            {% if alfajr_cod_settings.showFullName == nil or alfajr_cod_settings.showFullName %}
              <div class="alfajr-cod-v2__field">
                <label for="alfajr-name-{{ block.id }}">Nom complet</label>
                <input
                  id="alfajr-name-{{ block.id }}"
                  type="text"
                  name="full_name"
                  placeholder="Ex: Mohamed Amrani"
                  autocomplete="name"
                  maxlength="120"
                  required
                >
                <small data-error-for="full_name"></small>
              </div>
            {% endif %}

            {% if alfajr_cod_settings.showPhone == nil or alfajr_cod_settings.showPhone %}
              <div class="alfajr-cod-v2__field">
                <label for="alfajr-phone-{{ block.id }}">Téléphone</label>
                <input
                  id="alfajr-phone-{{ block.id }}"
                  type="tel"
                  name="phone"
                  placeholder="Ex: 0612345678"
                  autocomplete="tel"
                  inputmode="tel"
                  maxlength="20"
                  required
                >
                <small data-error-for="phone"></small>
              </div>
            {% endif %}

            {% if alfajr_cod_settings.showCity == nil or alfajr_cod_settings.showCity %}
              <div class="alfajr-cod-v2__field">
                <label for="alfajr-city-{{ block.id }}">Ville</label>
                <input
                  id="alfajr-city-{{ block.id }}"
                  type="text"
                  name="city"
                  placeholder="Ex: Fès, Casablanca..."
                  autocomplete="address-level2"
                  list="alfajr-cities-{{ block.id }}"
                  maxlength="100"
                  required
                >
                <datalist id="alfajr-cities-{{ block.id }}">
                  <option value="Fès">
                  <option value="Casablanca">
                  <option value="Rabat">
                  <option value="Marrakech">
                  <option value="Tanger">
                  <option value="Agadir">
                  <option value="Meknès">
                  <option value="Oujda">
                  <option value="Kénitra">
                  <option value="Tétouan">
                  <option value="Safi">
                  <option value="El Jadida">
                  <option value="Nador">
                  <option value="Béni Mellal">
                  <option value="Taza">
                  <option value="Settat">
                  <option value="Khouribga">
                  <option value="Errachidia">
                  <option value="Laâyoune">
                  <option value="Dakhla">
                </datalist>
                <small data-error-for="city"></small>
              </div>
            {% endif %}

            {% if alfajr_cod_settings.showAddress == nil or alfajr_cod_settings.showAddress %}
              <div class="alfajr-cod-v2__field alfajr-cod-v2__field--wide">
                <label for="alfajr-address-{{ block.id }}">Adresse complète</label>
                <textarea
                  id="alfajr-address-{{ block.id }}"
                  name="address"
                  placeholder="Quartier, rue, numéro de maison..."
                  autocomplete="street-address"
                  maxlength="500"
                  required
                ></textarea>
                <small data-error-for="address"></small>
              </div>
            {% endif %}

            {% if alfajr_cod_settings.showEmail %}
              <div class="alfajr-cod-v2__field alfajr-cod-v2__field--wide">
                <label for="alfajr-email-{{ block.id }}">Email <span>(optionnel)</span></label>
                <input
                  id="alfajr-email-{{ block.id }}"
                  type="email"
                  name="email"
                  placeholder="email@example.com"
                  autocomplete="email"
                  maxlength="254"
                >
                <small data-error-for="email"></small>
              </div>
            {% endif %}

            {% if alfajr_cod_settings.showNotes %}
              <div class="alfajr-cod-v2__field alfajr-cod-v2__field--wide">
                <label for="alfajr-notes-{{ block.id }}">Note <span>(optionnel)</span></label>
                <textarea
                  id="alfajr-notes-{{ block.id }}"
                  name="notes"
                  placeholder="Ajoutez une note si nécessaire..."
                  maxlength="1000"
                ></textarea>
              </div>
            {% endif %}
          </div>

          <div class="alfajr-cod-v2__summary" aria-live="polite">
            <div><span>Sous-total</span><strong data-cod-subtotal>0 DH</strong></div>
            <div><span>Livraison</span><strong data-cod-shipping>35 DH</strong></div>
            <div class="alfajr-cod-v2__total"><span>Total à payer</span><strong data-cod-total>0 DH</strong></div>
          </div>

          <button type="submit" class="alfajr-cod-v2__submit" data-cod-submit>
            <span data-submit-label>Confirmer ma commande</span>
            <span class="alfajr-cod-v2__spinner" data-submit-spinner hidden aria-hidden="true"></span>
          </button>

          <p class="alfajr-cod-v2__status" data-cod-status role="alert" aria-live="assertive"></p>
          <p class="alfajr-cod-v2__secure">✓ Paiement à la livraison · ✓ Confirmation téléphonique · ✓ Livraison partout au Maroc</p>
        </form>
      </div>

      <div class="alfajr-cod-v2__success" data-cod-success hidden>
        <div class="alfajr-cod-v2__success-icon">✓</div>
        <h2>Commande enregistrée</h2>
        <p>Merci. Nous vous contacterons rapidement pour confirmer votre commande.</p>
        <strong data-cod-order-name></strong>
        <button type="button" data-cod-success-close>Continuer mes achats</button>
      </div>
    </section>
  </div>

  <script type="application/json" data-variant-data>
  {
    {% for variant in product.variants %}
      "{{ variant.id }}": {
        "id": "{{ variant.id }}",
        "title": {{ variant.title | json }},
        "price": {{ variant.price }},
        "image": {{ variant.featured_image | default: product.featured_image | image_url: width: 180 | json }},
        "available": {{ variant.available | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  }
</script>

  <style>
    [data-alfajr-cod-root="{{ block.id }}"] {
      margin-top: 16px;
      --alfajr-blue: {{ alfajr_form_accent }};
      --alfajr-text: {{ alfajr_form_text }};
      --alfajr-border: {{ alfajr_form_border }};
      --alfajr-radius: {{ alfajr_border_radius }}px;
    }

    [data-alfajr-cod-root="{{ block.id }}"] * { box-sizing: border-box; }

    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__open {
      width: {{ alfajr_button_width }};
      min-height: 54px;
      border: 0;
      border-radius: var(--alfajr-radius);
      padding: 15px 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      background: {{ alfajr_button_color }};
      color: {{ alfajr_button_text_color }};
      font: inherit;
      font-size: 16px;
      font-weight: 850;
      cursor: pointer;
      box-shadow: 0 10px 26px rgba(13, 71, 199, .22);
      transition: transform .16s ease, box-shadow .16s ease;
    }

    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__open:hover {
      transform: translateY(-1px);
      box-shadow: 0 14px 32px rgba(13, 71, 199, .27);
    }

    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__overlay {
  position: fixed !important;
  inset: 0 !important;
  z-index: 2147483000 !important;

  display: none;
  align-items: center;
  justify-content: center;

  width: 100vw;
  height: 100dvh;
  padding:
    max(12px, env(safe-area-inset-top))
    12px
    max(12px, env(safe-area-inset-bottom));

  overflow: hidden;
  background: rgba(15, 23, 42, 0.68);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  box-sizing: border-box;
}

[data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__overlay.is-open {
  display: flex !important;
}

    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__dialog {
      position: relative;
      display: flex;
      flex-direction: column;
      width: min(640px, calc(100vw - 24px));
      max-height: calc(
        100dvh -
        max(24px, env(safe-area-inset-top)) -
        max(24px, env(safe-area-inset-bottom))
      );
      margin: 0;
      padding: 0;
      overflow: hidden;
      border: 1px solid var(--alfajr-border);
      border-radius: calc(var(--alfajr-radius) + 10px);
      background: {{ alfajr_form_bg }};
      color: var(--alfajr-text);
      box-shadow: 0 28px 90px rgba(15, 23, 42, .32);
    }

    [data-alfajr-cod-root="{{ block.id }}"] [data-cod-form-panel],
    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__success {
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      scrollbar-gutter: stable;
    }

    [data-alfajr-cod-root="{{ block.id }}"] [data-cod-form-panel] {
      padding: 22px;
    }

    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__close {
      position: absolute;
      top: 12px;
      right: 12px;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      border: 1px solid #dbe3ee;
      border-radius: 999px;
      background: #ffffff;
      color: #0f172a;
      font-size: 27px;
      line-height: 1;
      cursor: pointer;
      box-shadow: 0 6px 18px rgba(15, 23, 42, .18);
      transition: transform .15s ease, box-shadow .15s ease;
    }

    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__close:hover {
      transform: scale(1.04);
      box-shadow: 0 8px 22px rgba(15, 23, 42, .22);
    }

    html.alfajr-cod-modal-open,
    body.alfajr-cod-modal-open {
      overflow: hidden !important;
      overscroll-behavior: none;
    }
    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__header { padding-right: 42px; }
    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__eyebrow {
      display: inline-block;
      margin-bottom: 5px;
      color: var(--alfajr-blue);
      font-size: 12px;
      font-weight: 850;
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    [data-alfajr-cod-root="{{ block.id }}"] h2 {
      margin: 0;
      color: var(--alfajr-text);
      font-size: clamp(21px, 4vw, 27px);
      line-height: 1.15;
      font-weight: 900;
    }

    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__header p {
      margin: 7px 0 16px;
      color: #64748b;
      font-size: 14px;
      line-height: 1.45;
    }

    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__product {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px;
      margin-bottom: 14px;
      border: 1px solid rgba(13, 71, 199, .12);
      border-radius: calc(var(--alfajr-radius) + 3px);
      background: rgba(13, 71, 199, .055);
    }

    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__product img {
  width: 76px;
  height: 76px;
  flex: 0 0 76px;
  object-fit: cover;
  border-radius: 12px;
  background: #fff;
}

[data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__product-copy {
  min-width: 0;
  flex: 1;
}

    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__product strong {
      display: block;
      font-size: 14px;
      line-height: 1.3;
      font-weight: 850;
    }

    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__product span {
  display: block;
  margin-top: 4px;
  color: #64748b;
  font-size: 12px;
  line-height: 1.4;
}

[data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__variant b,
[data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__product-meta b {
  color: #0f172a;
  font-weight: 850;
}

[data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__product-meta i {
  margin: 0 4px;
  font-style: normal;
  opacity: 0.65;
}

    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__form { display: grid; gap: 12px; }
    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 11px;
    }

    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__field { display: grid; gap: 5px; }
    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__field--wide { grid-column: 1 / -1; }
    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__field label {
      color: var(--alfajr-text);
      font-size: 13px;
      font-weight: 800;
    }
    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__field label span { color: #64748b; font-weight: 600; }

    [data-alfajr-cod-root="{{ block.id }}"] input,
    [data-alfajr-cod-root="{{ block.id }}"] textarea {
      width: 100%;
      min-height: 48px;
      margin: 0;
      border: 1px solid var(--alfajr-border);
      border-radius: var(--alfajr-radius);
      padding: 12px 13px;
      background: #fff;
      color: #111827;
      font: inherit;
      font-size: 15px;
      outline: none;
      transition: border-color .15s ease, box-shadow .15s ease;
    }

    [data-alfajr-cod-root="{{ block.id }}"] textarea { min-height: 78px; resize: vertical; }
    [data-alfajr-cod-root="{{ block.id }}"] input:focus,
    [data-alfajr-cod-root="{{ block.id }}"] textarea:focus {
      border-color: var(--alfajr-blue);
      box-shadow: 0 0 0 3px rgba(13, 71, 199, .11);
    }
    [data-alfajr-cod-root="{{ block.id }}"] [aria-invalid="true"] { border-color: #dc2626; }
    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__field small {
      min-height: 14px;
      color: #dc2626;
      font-size: 11px;
      font-weight: 700;
    }

    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__field--quantity { max-width: 190px; }
    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__quantity {
      display: grid;
      grid-template-columns: 44px 1fr 44px;
      gap: 7px;
    }
    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__quantity button {
      border: 0;
      border-radius: var(--alfajr-radius);
      background: var(--alfajr-blue);
      color: #fff;
      font-size: 21px;
      cursor: pointer;
    }
    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__quantity input { text-align: center; font-weight: 850; }

    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__summary {
      padding: 14px;
      border: 1px solid var(--alfajr-border);
      border-radius: var(--alfajr-radius);
      background: #f8fafc;
    }
    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__summary > div {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding: 4px 0;
      color: #475569;
      font-size: 14px;
    }
    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__summary strong { color: #0f172a; }
    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__total {
      margin-top: 7px;
      padding-top: 11px !important;
      border-top: 1px solid var(--alfajr-border);
      font-size: 18px !important;
      font-weight: 900;
    }

    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__submit {
      min-height: 54px;
      border: 0;
      border-radius: var(--alfajr-radius);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      padding: 14px 18px;
      background: {{ alfajr_button_color }};
      color: {{ alfajr_button_text_color }};
      font: inherit;
      font-size: 16px;
      font-weight: 900;
      cursor: pointer;
      box-shadow: 0 10px 25px rgba(13, 71, 199, .2);
    }
    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__submit:disabled { opacity: .68; cursor: wait; }
    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__spinner {
      width: 18px;
      height: 18px;
      border: 2px solid currentColor;
      border-right-color: transparent;
      border-radius: 50%;
      animation: alfajrCodSpin .7s linear infinite;
    }
    @keyframes alfajrCodSpin { to { transform: rotate(360deg); } }

    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__status {
      min-height: 18px;
      margin: 0;
      color: #b91c1c;
      text-align: center;
      font-size: 13px;
      font-weight: 700;
    }
    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__secure {
      margin: -3px 0 0;
      color: #64748b;
      text-align: center;
      font-size: 11px;
      line-height: 1.45;
    }

    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__honeypot {
      position: absolute !important;
      left: -10000px !important;
      width: 1px !important;
      height: 1px !important;
      overflow: hidden !important;
    }

    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__success {
      min-height: 390px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
      text-align: center;
    }
    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__success[hidden] { display: none; }
    [data-alfajr-cod-root="{{ block.id }}"] .alfajr-cod-v2__success-icon {
      width: 68px;
