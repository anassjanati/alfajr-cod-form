  </style>

  <script>
    (() => {
      const root = document.currentScript.closest('[data-alfajr-cod-root]');
      if (!root || root.dataset.codInitialized === 'true') return;
      root.dataset.codInitialized = 'true';

      const overlay = root.querySelector('[data-cod-overlay]');
      const openButton = root.querySelector('[data-cod-open]');
      const variantDataNode = root.querySelector('[data-variant-data]');

      if (!overlay || !openButton || !variantDataNode) return;

      /*
       * Move the overlay to <body>.
       * This removes it from theme sections that create their own stacking
       * context, so the COD modal always appears above the sticky header.
       */
      const blockId = root.getAttribute('data-alfajr-cod-root');
      document.querySelectorAll('[data-alfajr-cod-portal]').forEach((node) => {
        if (node.getAttribute('data-alfajr-cod-portal') === blockId) {
          node.remove();
        }
      });

      const portal = document.createElement('div');
      portal.setAttribute('data-alfajr-cod-portal', blockId);
      portal.setAttribute('data-alfajr-cod-root', blockId);
      document.body.appendChild(portal);
      portal.appendChild(overlay);

      const closeButtons = overlay.querySelectorAll(
        '[data-cod-close], [data-cod-success-close]'
      );
      const formPanel = overlay.querySelector('[data-cod-form-panel]');
      const successPanel = overlay.querySelector('[data-cod-success]');
      const form = overlay.querySelector('[data-cod-form]');
      const submitButton = overlay.querySelector('[data-cod-submit]');
      const submitLabel = overlay.querySelector('[data-submit-label]');
      const submitSpinner = overlay.querySelector('[data-submit-spinner]');
      const status = overlay.querySelector('[data-cod-status]');
      const quantityInput = form?.elements.quantity;
      const cityInput = form?.elements.city;
      const variantInput = form?.elements.variant_id;
      const productImage = overlay.querySelector('[data-cod-product-image]');
      const variantRow = overlay.querySelector('[data-cod-variant-row]');
      const variantTitle = overlay.querySelector('[data-cod-variant-title]');
      const unitPrice = overlay.querySelector('[data-cod-unit-price]');
      const subtotalOutput = overlay.querySelector('[data-cod-subtotal]');
      const shippingOutput = overlay.querySelector('[data-cod-shipping]');
      const totalOutput = overlay.querySelector('[data-cod-total]');
      const orderNameOutput = overlay.querySelector('[data-cod-order-name]');
      const quantityPlus = overlay.querySelector('[data-qty-plus]');
      const quantityMinus = overlay.querySelector('[data-qty-minus]');

      const productCard = overlay.querySelector('[data-cod-product-card]');
      const cartProducts = overlay.querySelector('[data-cod-cart-products]');
      const quantityField = quantityInput?.closest('.alfajr-cod-v2__field--quantity');

      let checkoutContext = {
        mode: 'product',
        source: 'product-page',
        variantId: '',
        items: [],
        subtotalCents: 0
      };

      let lastOpener = openButton;

      if (
        !form ||
        !formPanel ||
        !successPanel ||
        !submitButton ||
        !submitLabel ||
        !submitSpinner ||
        !status
      ) {
        portal.remove();
        return;
      }

      let variantData = {};

      try {
        variantData = JSON.parse(variantDataNode.textContent || '{}');
      } catch (_) {
        variantData = {};
      }

      const money = (value) => `${Number(value || 0).toFixed(2)} DH`;
      const moneyFromCents = (value) => money(Number(value || 0) / 100);

function toCents(value) {
  const amount = Number(value);
  return Number.isFinite(amount) ? Math.max(0, Math.round(amount)) : 0;
}

function normalizeCartItems(rawItems) {
  return (Array.isArray(rawItems) ? rawItems : [])
    .map((item) => {
      const variantId = String(item?.variantId || '').trim();

      if (!variantId) return null;

      const quantity = Math.min(
        100,
        Math.max(1, Math.floor(Number(item.quantity || 1)))
      );

      const unitPriceCents = toCents(item.unitPriceCents);
      const linePrice = Number(item.linePriceCents);

      return {
        variantId,
        quantity,
        title: String(item.title || 'Produit'),
        variantTitle: String(item.variantTitle || ''),
        image: String(item.image || ''),
        unitPriceCents,
        linePriceCents: Number.isFinite(linePrice)
          ? toCents(linePrice)
          : unitPriceCents * quantity
      };
    })
    .filter(Boolean);
}

function renderCartProducts(items) {
  if (!cartProducts) return;

  const fragment = document.createDocumentFragment();

  items.forEach((item) => {
    const card = document.createElement('div');
    card.className = 'alfajr-cod-v2__product';

    if (item.image) {
      const image = document.createElement('img');
      image.src = item.image;
      image.alt = item.title;
      image.width = 76;
      image.height = 76;
      image.loading = 'eager';

      image.addEventListener('error', () => image.remove(), { once: true });

      card.appendChild(image);
    }

    const copy = document.createElement('div');
    copy.className = 'alfajr-cod-v2__product-copy';

    const title = document.createElement('strong');
    title.textContent = item.title;
    copy.appendChild(title);

    if (item.variantTitle && item.variantTitle !== 'Default Title') {
      const variant = document.createElement('span');
      variant.className = 'alfajr-cod-v2__variant';

      const prefix = document.createTextNode('Variante : ');
      const value = document.createElement('b');
      value.textContent = item.variantTitle;

      variant.append(prefix, value);
      copy.appendChild(variant);
    }

    const meta = document.createElement('span');
    meta.className = 'alfajr-cod-v2__product-meta';

    const quantity = document.createElement('span');
    quantity.textContent = `Quantité : ${item.quantity}`;

    const lineTotal = document.createElement('b');
    lineTotal.className = 'alfajr-cod-v2__cart-line-total';
    lineTotal.textContent = moneyFromCents(item.linePriceCents);

    meta.append(quantity, document.createTextNode(' • '), lineTotal);
    copy.appendChild(meta);

    card.appendChild(copy);
    fragment.appendChild(card);
  });

  cartProducts.replaceChildren(fragment);
}

function setCheckoutContext(context = {}) {
  const isCartCheckout = context.mode === 'cart';

  if (!isCartCheckout) {
    checkoutContext = {
      mode: 'product',
      source: context.source || 'product-page',
      variantId: String(context.variantId || ''),
      items: [],
      subtotalCents: 0
    };

    if (productCard) productCard.hidden = false;
    if (cartProducts) cartProducts.hidden = true;
    if (quantityField) quantityField.hidden = false;
    if (quantityInput) quantityInput.disabled = false;

    return;
  }

  const items = normalizeCartItems(context.items);

  if (!items.length) {
    throw new Error('Votre panier est vide. Ajoutez un produit avant de commander.');
  }

  const suppliedSubtotal = Number(context.subtotalCents);
  const subtotalCents = Number.isFinite(suppliedSubtotal)
    ? toCents(suppliedSubtotal)
    : items.reduce((sum, item) => sum + item.linePriceCents, 0);

  checkoutContext = {
    mode: 'cart',
    source: String(context.source || 'cart-page'),
    items,
    subtotalCents
  };

  if (productCard) productCard.hidden = true;

  if (cartProducts) {
    cartProducts.hidden = false;
    renderCartProducts(items);
  }

  if (quantityField) quantityField.hidden = true;
  if (quantityInput) quantityInput.disabled = true;
  if (variantInput) variantInput.value = '';
}
      const createRequestId = () =>
        window.crypto?.randomUUID?.() ||
        `${Date.now()}-${Math.random().toString(36).slice(2)}-${Math.random().toString(36).slice(2)}`;

      function normalizeCity(city) {
        return String(city || '')
          .toLocaleLowerCase('fr-MA')
          .trim()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[\u064B-\u065F\u0670\u06D6-\u06ED]/g, '')
          .replace(/[أإآٱ]/g, 'ا')
          .replace(/ـ/g, '')
          .replace(/[،؛؟]/g, ' ')
          .replace(/([a-z\u0600-\u06ff])\1+/gu, '$1')
          .replace(/[^a-z0-9\u0600-\u06ff]+/gu, ' ')
          .trim();
      }

      function isFes(city) {
        const aliases = new Set(['fes', 'fez', 'fas', 'فاس', 'فس']);
        return normalizeCity(city).split(/\s+/).some((token) => aliases.has(token));
      }

      // جلب مناطق الشحن من الـ Metafields (لوحة التحكم)
      const rawShippingZones = {{ app.metafields.cod_settings.shipping.value | json }};
      let shippingZones = [];

      try {
        shippingZones = Array.isArray(rawShippingZones)
          ? rawShippingZones
          : typeof rawShippingZones === 'string'
            ? JSON.parse(rawShippingZones)
            : [];
      } catch (_) {
        shippingZones = [];
      }

      function shippingFee() {
  // الحصول على اسم المدينة التي أدخلها العميل
  const rawCity = (typeof cityInput !== 'undefined' ? cityInput?.value : form?.city?.value) || "";
  const city = normalizeCity(rawCity);
  
  const isFesCity = isFes(rawCity);

  if (isFesCity) {
    // إذا كانت فاس، نتحقق مما إذا كان التاجر قد حدد لها سعراً في لوحة التحكم
    const fesZone = shippingZones.find(z => isFes(z.zone));
    return fesZone ? Number(fesZone.fee) : 20;
  } else {
    // إذا لم تكن فاس، نبحث عن المدينة المحددة في لوحة التحكم
    const specificZone = shippingZones.find(z => normalizeCity(z.zone) === city);
    if (specificZone) return Number(specificZone.fee);

    // إذا لم تكن مسجلة، نبحث عن السعر الافتراضي للمغرب، أو نطبق 35 درهم
    const defaultZone = shippingZones.find(z => normalizeCity(z.zone) === 'maroc' || normalizeCity(z.zone) === 'المغرب');
    return defaultZone ? Number(defaultZone.fee) : 35;
  }
}

      function currentVariantId() {
  if (checkoutContext.mode === 'product' && checkoutContext.variantId) {
    return checkoutContext.variantId;
  }

  const productSection = root.closest('section') || document;

  const selectors = [
    'form[action*="/cart/add"] [name="id"]',
    'input[name="id"]:checked',
    'select[name="id"]',
    'input[name="variant-id"]'
  ];

  for (const selector of selectors) {
    const element =
      productSection.querySelector(selector) ||
      document.querySelector(selector);

    if (element?.value) return String(element.value);
  }

  return (
    new URLSearchParams(location.search).get('variant') ||
    root.dataset.defaultVariant
  );
}

      function updateSummary() {
  const shipping = shippingFee();

  if (checkoutContext.mode === 'cart') {
    const subtotal = Number(checkoutContext.subtotalCents || 0) / 100;

    if (subtotalOutput) subtotalOutput.textContent = money(subtotal);
    if (shippingOutput) shippingOutput.textContent = money(shipping);
    if (totalOutput) totalOutput.textContent = money(subtotal + shipping);

    return;
  }

  const variantId = currentVariantId();

  if (variantInput && variantId) {
    variantInput.value = variantId;
  }

  const selectedVariant = variantData[variantId] || {};
  const selectedUnitPrice = Number(selectedVariant.price || 0) / 100;

  const quantity = Math.min(
    100,
    Math.max(1, Number(quantityInput?.value || 1))
  );

  const subtotal = selectedUnitPrice * quantity;

  if (variantTitle) {
    variantTitle.textContent = selectedVariant.title || '';
  }

  if (variantRow) {
    variantRow.hidden =
      !selectedVariant.title ||
      selectedVariant.title === 'Default Title';
  }

  if (unitPrice) {
    unitPrice.textContent = money(selectedUnitPrice);
  }

  if (productImage && selectedVariant.image) {
    productImage.src = selectedVariant.image;
  }

  if (subtotalOutput) subtotalOutput.textContent = money(subtotal);
  if (shippingOutput) shippingOutput.textContent = money(shipping);
  if (totalOutput) totalOutput.textContent = money(subtotal + shipping);
}
      function normalizePhone(value) {
        let phone = String(value || '').replace(/[\s\-()]/g, '').trim();
        if (phone.startsWith('+212')) phone = `0${phone.slice(4)}`;
        if (phone.startsWith('212')) phone = `0${phone.slice(3)}`;
        return phone;
      }

      function setError(name, message) {
        const error = form.querySelector(`[data-error-for="${name}"]`);
        const input = form.elements[name];
        if (error) error.textContent = message || '';
        if (input) input.setAttribute('aria-invalid', message ? 'true' : 'false');
      }

      function clearErrors() {
        ['full_name', 'phone', 'city', 'address', 'email'].forEach((name) => setError(name, ''));
        status.textContent = '';
      }

      function validate() {
        clearErrors();
        let valid = true;
        const values = {
          full_name: form.elements.full_name?.value?.trim() || '',
          phone: normalizePhone(form.elements.phone?.value || ''),
          city: form.elements.city?.value?.trim() || '',
          address: form.elements.address?.value?.trim() || '',
          email: form.elements.email?.value?.trim() || ''
        };

        if (form.elements.full_name && values.full_name.length < 2) {
          setError('full_name', 'Veuillez entrer votre nom complet.'); valid = false;
        }
        if (form.elements.phone && !/^(06|07)\d{8}$/.test(values.phone)) {
          setError('phone', 'Veuillez entrer un numéro marocain valide.'); valid = false;
        }
        if (form.elements.city && values.city.length < 2) {
          setError('city', 'Veuillez entrer votre ville.'); valid = false;
        }
        if (form.elements.address && values.address.length < 5) {
          setError('address', 'Veuillez entrer une adresse complète.'); valid = false;
        }
        if (values.email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(values.email)) {
          setError('email', 'Veuillez entrer un email valide.'); valid = false;
        }

        if (!valid) form.querySelector('[aria-invalid="true"]')?.focus();
        return valid;
      }

      function emitEvent(name, detail = {}) {
        window.dataLayer?.push?.({ event: name, ...detail });
        if (typeof window.fbq === 'function') {
          window.fbq('trackCustom', name, detail);
        }
        document.dispatchEvent(new CustomEvent(name, { detail }));
      }

      function trackingData() {
        const params = new URLSearchParams(location.search);
        return {
          utmSource: params.get('utm_source') || '',
          utmMedium: params.get('utm_medium') || '',
          utmCampaign: params.get('utm_campaign') || '',
          utmContent: params.get('utm_content') || '',
          utmTerm: params.get('utm_term') || '',
          fbclid: params.get('fbclid') || '',
          landingPage: location.href.slice(0, 500),
          referrer: document.referrer.slice(0, 500)
        };
      }

      function openModal(trigger) {
  lastOpener =
    trigger instanceof HTMLElement
      ? trigger
      : document.activeElement instanceof HTMLElement
        ? document.activeElement
        : openButton;

  formPanel.hidden = false;
  successPanel.hidden = true;

  clearErrors();

  form.elements.form_started_at.value = String(Date.now());
  form.elements.idempotency_key.value = createRequestId();
  form.dataset.started = '';

  overlay.classList.add('is-open');
  overlay.setAttribute('aria-hidden', 'false');

  document.documentElement.classList.add('alfajr-cod-modal-open');
  document.body.classList.add('alfajr-cod-modal-open');

  formPanel.scrollTop = 0;
  successPanel.scrollTop = 0;

  updateSummary();

  emitEvent('cod_form_view', {
    mode: checkoutContext.mode,
    source: checkoutContext.source,
    variantId:
      checkoutContext.mode === 'product'
        ? currentVariantId()
        : '',
    itemCount:
      checkoutContext.mode === 'cart'
        ? checkoutContext.items.length
        : 1
  });

  window.setTimeout(() => {
    form.elements.full_name?.focus({ preventScroll: true });
  }, 80);
}

function openCheckout(context = {}, trigger) {
  setCheckoutContext(context);
  openModal(trigger);
}

function close() {
  overlay.classList.remove('is-open');
  overlay.setAttribute('aria-hidden', 'true');

  document.documentElement.classList.remove('alfajr-cod-modal-open');
  document.body.classList.remove('alfajr-cod-modal-open');

  if (lastOpener?.isConnected) {
    lastOpener.focus({ preventScroll: true });
  } else {
    openButton.focus({ preventScroll: true });
  }
}

openButton.addEventListener('click', () => {
  openCheckout(
    {
      mode: 'product',
      source: 'product-page'
    },
    openButton
  );
});

window.ALFajrCOD = window.ALFajrCOD || {};

if (
  typeof window.ALFajrCOD.open !== 'function' ||
  !window.ALFajrCOD._modalRoot?.isConnected
) {
  window.ALFajrCOD.open = (context, options = {}) => {
    openCheckout(context, options.trigger);
  };

  window.ALFajrCOD.close = close;
  window.ALFajrCOD._modalRoot = root;
}

      closeButtons.forEach((button) => {
        button.addEventListener('click', close);
      });

      /*
       * Intentionally no overlay-click or Escape-key listener.
       * The customer can close the form only with the visible close button.
       */

      quantityPlus?.addEventListener('click', () => {
        quantityInput.value = String(
          Math.min(100, Number(quantityInput.value || 1) + 1)
        );
        updateSummary();
      });

      quantityMinus?.addEventListener('click', () => {
        quantityInput.value = String(
          Math.max(1, Number(quantityInput.value || 1) - 1)
        );
        updateSummary();
      });
      cityInput?.addEventListener('input', updateSummary);
      quantityInput?.addEventListener('input', updateSummary);

      document.addEventListener('change', (event) => {
  if (
    event.target?.matches?.(
      '[name="id"], [name="variant-id"], [data-option-value-id], [name^="options"]'
    )
  ) {
    window.setTimeout(updateSummary, 0);
  }
});

document.addEventListener('variant:change', () => {
  window.setTimeout(updateSummary, 0);
});

      form.addEventListener('input', () => {
        if (form.dataset.started) return;

        form.dataset.started = 'true';

        emitEvent('cod_form_start', {
          mode: checkoutContext.mode,
          source: checkoutContext.source,
          variantId:
            checkoutContext.mode === 'product'
              ? currentVariantId()
              : '',
          itemCount:
            checkoutContext.mode === 'cart'
              ? checkoutContext.items.length
              : 1
        });
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!validate()) return;

        const requestId = form.elements.idempotency_key.value || createRequestId();
        form.elements.idempotency_key.value = requestId;

        const isCartCheckout = checkoutContext.mode === 'cart';

const payload = {
  ...(isCartCheckout
    ? {
        items: checkoutContext.items.map((item) => ({
          variantId: item.variantId,
          quantity: item.quantity
        }))
      }
    : {
        variantId: currentVariantId(),
        quantity: Math.min(
          100,
          Math.max(1, Number(quantityInput?.value || 1))
        )
      }),

  fullName: form.elements.full_name?.value?.trim() || '',
  phone: normalizePhone(form.elements.phone?.value || ''),
  city: form.elements.city?.value?.trim() || '',
  address: form.elements.address?.value?.trim() || '',
  email: form.elements.email?.value?.trim() || '',
  notes: form.elements.notes?.value?.trim() || '',
  website: form.elements.website?.value || '',
  formStartedAt: Number(form.elements.form_started_at.value || Date.now()),
  idempotencyKey: requestId,
  ...trackingData()
};

if (!isCartCheckout && !payload.variantId) {
  status.textContent = 'Veuillez sélectionner une variante disponible.';
  return;
}

        submitButton.disabled = true;
        submitLabel.textContent = 'Enregistrement...';
        submitSpinner.hidden = false;
        status.textContent = '';
        emitEvent('cod_submit', {
  mode: checkoutContext.mode,
  source: checkoutContext.source,
  variantId: payload.variantId || '',
  itemCount: isCartCheckout ? payload.items.length : 1,
  city: payload.city
});

        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 15000);

        let rotateRequestId = false;

        try {
          const response = await fetch('/apps/alfajr-cod/api/cod', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
            signal: controller.signal,
            credentials: 'same-origin'
          });

          const result = await response.json().catch(() => ({}));

          if (!response.ok || !result.success) {
            if (result.errors) {
              Object.entries(result.errors).forEach(([name, message]) => setError(name, message));
            }
            rotateRequestId = response.status !== 409 && !result.processing;
            throw new Error(result.message || 'La commande n’a pas pu être envoyée.');
          }

          formPanel.hidden = true;
          successPanel.hidden = false;
          if (orderNameOutput) {
            orderNameOutput.textContent = result.order?.name || '';
          }
          emitEvent('cod_order_success', {
            orderName: result.order?.name || '',
            value: result.order?.total || 0,
            currency: result.order?.currency || 'MAD',
            shippingFee: result.shippingFee
          });
        } catch (error) {
          const message = error?.name === 'AbortError'
            ? 'Le serveur prend trop de temps. Vérifiez votre connexion puis réessayez.'
            : error?.message || 'Erreur de connexion. Veuillez réessayer.';
          status.textContent = message;
          if (rotateRequestId) form.elements.idempotency_key.value = createRequestId();
          emitEvent('cod_order_error', { message });
        } finally {
          clearTimeout(timeout);
          submitButton.disabled = false;
          submitLabel.textContent = 'Confirmer ma commande';
          submitSpinner.hidden = true;
        }
      });

      updateSummary();
    })();
  </script>
</div>

